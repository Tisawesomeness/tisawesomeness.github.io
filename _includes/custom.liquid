{% comment %}
  Replace {::bug:PROJECT-ID} patterns with links to bugs.mojang.com
  Replace {::bug:LABEL:PROJECT-ID} patterns with links using LABEL as the link text
  Replace {::color:COLOR} patterns with a square of that color
  Replace {::colordef:COLOR} patterns with a square of that color and the color's hex code in monospace
  Replace {::hint:TEXT:HINT} patterns with a tooltip showing HINT on hover over TEXT
  Usage: {% include custom.liquid html=content %}
{% endcomment %}

{% assign result = include.html %}
{% assign parts = result | split: '{::' %}

{% capture processed %}{% endcapture %}

{% for part in parts %}
  {% if forloop.first %}
    {% capture processed %}{{ processed }}{{ part }}{% endcapture %}
  {% else %}
    {% assign closing = part | split: '}' %}
    {% assign typeAndArg = closing | first %}
    {% assign rest = part | remove_first: typeAndArg | remove_first: '}' %}

    {% assign punctuation = "" %}
    {% assign char = rest | slice: 0 %}
    {% if char == ")" %}
      {% assign punctuation = char %}
      {% assign rest = rest | remove_first: char %}
      {% assign char = rest | slice: 0 %}
    {% endif %}
    {% if ".,:;-" contains char %}
      {% capture punctuation %}{{ punctuation }}{{ char }}{% endcapture %}
      {% assign rest = rest | remove_first: char %}
    {% endif %}

    {% assign splitByColon = typeAndArg | split: ':' %}
    {% assign type = splitByColon | first %}
    {% assign arg = typeAndArg | remove_first: type | remove_first: ':' %}

    {% case type %}

      {% when 'bug' %}
        {% assign argParts = arg | split: ':' %}
        {% assign label = argParts | first %}
        {% assign projectId = argParts | last %}
        {% if projectId contains '-' %}
          {% assign project = projectId | split: '-' | first %}
          {% assign id = projectId | split: '-' | last %}
          {% if label != '' and project != '' and id != '' %}
            {% capture output %}{% include bug.liquid %}{% endcapture %}
          {% else %}
            {% assign output = part %}
          {% endif %}
        {% else %}
          {% assign output = part %}
        {% endif %}

      {% when 'color' %}
        {% capture output %}<span class="color-preview" style="background-color: {{ arg }}"></span>{% endcapture %}

      {% when 'colordef' %}
        {% capture output %}<span class="color-preview" style="background-color: {{ arg }}"></span> <code class="language-plaintext">{{ arg }}</code>{% endcapture %}

      {% when 'hint' %}
        {% assign argParts = arg | split: ':' %}
        {% assign text = argParts | first %}
        {% assign hint = argParts | last %}
        {% capture output %}<span class="tooltip-label"><span class="tooltip-text">{{ hint }}</span>{{ text }}</span>{% endcapture %}

      {% else %}
        {% assign output = part %}

    {% endcase %}

    {% if punctuation == "" %}
      {% capture processed %}{{ processed }}{{ output }}{{ rest }}{% endcapture %}
    {% else %}
      {% capture processed %}{{ processed }}<span style="display: inline-block;">{{ output }}{{ punctuation }}</span>{{ rest }}{% endcapture %}
    {% endif %}

  {% endif %}
{% endfor %}

{{ processed }}
