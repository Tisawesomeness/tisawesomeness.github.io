---
layout: none
---
[
  {% for post in site.categories["snapshots"] %}
    {% capture processed_content %}{% include custom_plain.html html=post.content %}{% endcapture %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.category }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "release"  : "{{ post.release | default: 'unknown' }}",
      "stage"    : "{{ post.stage | default: 'unknown' }}",
      "url"      : "{{ post.url | relative_url }}",
      "date"     : "{{ post.date }}",
      "content"  : {{ processed_content | strip_html | replace: "\r\n", "\n" | replace: "\n", " " | strip | escape | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]